# --- Secrets & local config (NEVER commit) ---
.env
.env.local
*.key
*.pem
*.secret
secrets/
data/.api-key

# --- Runtime data / sessions (per-user, often large) ---
data/
sessions/
*.sqlite
*.sqlite-*
whisper-models/

# --- Personalized persona generated by the setup wizard ---
prompts/assistant.local.md
prompts/*.local.md

# --- Node / Python ---
node_modules/
.venv/
__pycache__/
*.pyc

# --- OS / editor noise ---
.DS_Store
*.log
*.tmp
npm-debug.log*
