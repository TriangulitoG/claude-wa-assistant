# ============================================================================
#  claude-wa-assistant — configuración
#  Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` a git.
#  Lo normal es NO editar esto a mano: ejecuta `npm run setup` y el asistente
#  de configuración te lo genera. Esto es solo la referencia de cada variable.
# ============================================================================

# --- Gateway de WhatsApp (OpenWA / WAHA, API REST compatible) ------------------
# URL base del gateway que habla con WhatsApp Web por ti.
WA_BASE_URL=http://localhost:2785
# Id de la sesión dentro del gateway (lo crea el gateway al arrancar).
WA_SESSION_ID=
# API key del gateway. Usa UNA de las dos: el valor directo, o un archivo que
# lo contenga (recomendado, así la clave no vive en el .env).
WA_API_KEY=
WA_API_KEY_FILE=

# --- A quién responde el asistente -------------------------------------------
# El chat del "dueño": el número que habla con el asistente, en formato
# <numero>@c.us (sin +, con prefijo de país). El asistente SOLO responde a este
# chat (ver política de seguridad en el README).
WA_OWNER_CHAT_ID=

# Modo de número:
#   dedicated = el asistente corre en un número APARTE y tú le escribes desde el
#               tuyo (WA_OWNER_CHAT_ID = tu número).
#   own       = el asistente corre en TU PROPIO número (te hablas a ti mismo /
#               "mensajes contigo mismo"); WA_OWNER_CHAT_ID = tu propio número.
WA_MODE=dedicated

# --- Personalidad (la rellena el asistente de configuración) -----------------
ASSISTANT_NAME=Asistente
# Idioma principal (ISO 639-1): es, en, pt, fr...
ASSISTANT_LANG=es
# Ruta a una imagen para la foto de perfil del asistente (opcional). Se aplica
# con `node scripts/set-profile.mjs` cuando la sesión esté vinculada.
PROFILE_PICTURE=

# --- Texto a voz (TTS, respuestas en nota de voz) ----------------------------
# Voz de edge-tts. Lista: `edge-tts --list-voices`. Ej: es-ES-AlvaroNeural,
# es-MX-DaliaNeural, en-US-GuyNeural...
TTS_VOICE=es-ES-AlvaroNeural
# Responder en voz cuando te hablan por voz (true/false).
TTS_REPLY_TO_VOICE=true

# --- Voz a texto (STT, transcripción de las notas que te mandan) -------------
# Modelo de faster-whisper: tiny, base, small, medium, large-v3 (más grande =
# mejor y más lento). "small" es un buen equilibrio en CPU.
STT_MODEL=small
# Idioma que fuerza la transcripción (deja vacío para autodetectar).
STT_LANG=es

# --- El cerebro: Claude Code -------------------------------------------------
# Ruta al binario de Claude Code. Debe estar instalado y con sesión iniciada
# (suscripción Pro/Max). Comprueba con `claude --version`.
CLAUDE_BIN=claude
# Argumentos extra para cada invocación headless (opcional).
CLAUDE_EXTRA_ARGS=

# --- Ajustes del vigilante ---------------------------------------------------
# Cada cuánto sondea mensajes nuevos (ms). No bajar de ~10000 para no chocar
# con el rate-limit del gateway.
POLL_MS=12000
